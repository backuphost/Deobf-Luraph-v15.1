diff --git a/CLI/src/Repl.cpp b/CLI/src/Repl.cpp
index 7ecaabc..2551b4c 100644
--- a/CLI/src/Repl.cpp
+++ b/CLI/src/Repl.cpp
@@ -120,6 +120,43 @@ static int lua_loadstring(lua_State* L)
     return 2;          // return nil plus error message
 }
 
+static int lua_readfile_(lua_State* L)
+{
+    const char* path = luaL_checkstring(L, 1);
+    FILE* f = fopen(path, "rb");
+    if (!f)
+        luaL_error(L, "cannot open %s", path);
+    std::string data;
+    char buf[65536];
+    size_t n;
+    while ((n = fread(buf, 1, sizeof(buf), f)) > 0)
+        data.append(buf, n);
+    fclose(f);
+    lua_pushlstring(L, data.data(), data.size());
+    return 1;
+}
+
+static int lua_writefile_(lua_State* L)
+{
+    const char* path = luaL_checkstring(L, 1);
+    size_t l = 0;
+    const char* s = luaL_checklstring(L, 2, &l);
+    FILE* f = fopen(path, "wb");
+    if (!f)
+        luaL_error(L, "cannot open %s", path);
+    fwrite(s, 1, l, f);
+    fclose(f);
+    return 0;
+}
+
+static int lua_ewrite_(lua_State* L)
+{
+    size_t l = 0;
+    const char* s = luaL_checklstring(L, 1, &l);
+    fwrite(s, 1, l, stderr);
+    return 0;
+}
+
 static int lua_collectgarbage(lua_State* L)
 {
     const char* option = luaL_optstring(L, 1, "collect");
@@ -218,6 +255,9 @@ void setupState(lua_State* L)
     static const luaL_Reg funcs[] = {
         {"loadstring", lua_loadstring},
         {"collectgarbage", lua_collectgarbage},
+        {"readfile", lua_readfile_},
+        {"writefile", lua_writefile_},
+        {"ewrite", lua_ewrite_},
 #ifdef CALLGRIND
         {"callgrind", lua_callgrind},
 #endif
