+// devm: resume a coroutine the way a scheduler does (no parent thread), so that it starts with
+// the full C stack budget instead of inheriting the depth of the caller like coroutine.resume
+static int lua_resumetop_(lua_State* L)
+{
+    lua_State* co = lua_tothread(L, 1);
+    luaL_argexpected(L, co, 1, "thread");
+    int narg = lua_gettop(L) - 1;
+    int costatus = lua_costatus(L, co);
+    if (costatus != LUA_COSUS)
+    {
+        lua_pushboolean(L, 0);
+        lua_pushstring(L, "cannot resume non-suspended coroutine");
+        return 2;
+    }
+    if (!lua_checkstack(co, narg))
+        luaL_error(L, "too many arguments to resume");
+    lua_xmove(L, co, narg);
+    int status = lua_resume(co, NULL, narg);
+    if (status == 0 || status == LUA_YIELD)
+    {
+        int nres = lua_gettop(co);
+        if (!lua_checkstack(L, nres + 1))
+            luaL_error(L, "too many results to resume");
+        lua_pushboolean(L, 1);
+        lua_xmove(co, L, nres);
+        return nres + 1;
+    }
+    lua_pushboolean(L, 0);
+    lua_xmove(co, L, 1);
+    return 2;
+}
+
+// devm: cwrap(name, impl) -> C closure that runs the Lua function `impl` on a thread of its own.
+// To the caller the result is a C function in every respect: one call frame, no C-stack depth
+// of the implementation, "[C]" in debug.info and stack walks, errors prefixed with the position
+// of the calling Lua function exactly as luaL_error does.  `impl` raises with error(msg, 0) and
+// must not yield.
+// With a second upvalue (a marker value) the implementation also receives the calling thread as
+// its first argument, and returning the marker alone makes the *caller* yield (task.wait).
+static int cwrap_call_(lua_State* L)
+{
+    int n = lua_gettop(L);
+    bool yielder = !lua_isnoneornil(L, lua_upvalueindex(2));
+    luaL_checkstack(L, n + 5, "cwrap");
+    lua_State* co = lua_newthread(L);
+    lua_pushvalue(L, lua_upvalueindex(1));
+    if (yielder)
+        lua_pushthread(L);
+    for (int i = 1; i <= n; i++)
+        lua_pushvalue(L, i);
+    lua_xmove(L, co, n + 1 + (yielder ? 1 : 0));
+    int status = lua_resume(co, NULL, n + (yielder ? 1 : 0));
+    if (status == 0)
+    {
+        int nres = lua_gettop(co);
+        luaL_checkstack(L, nres + 1, "cwrap");
+        lua_xmove(co, L, nres);
+        if (yielder && nres == 1 && lua_rawequal(L, -1, lua_upvalueindex(2)))
+        {
+            lua_settop(L, 0);
+            return lua_yield(L, 0);
+        }
+        return nres;
+    }
+    if (status == LUA_YIELD)
+        luaL_error(L, "attempt to yield across metamethod/C-call boundary");
+    if (lua_type(co, -1) == LUA_TSTRING)
+    {
+        size_t len = 0;
+        const char* msg = lua_tolstring(co, -1, &len);
+        std::string text(msg, len);
+        if (text.compare(0, 6, "__LPH_") == 0)
+            lua_pushlstring(L, text.data(), text.size()); // harness control message: passed on as is
+        else
+        {
+            luaL_where(L, 1);
+            lua_pushlstring(L, text.data(), text.size());
+            lua_concat(L, 2);
+        }
+    }
+    else
+        lua_xmove(co, L, 1);
+    lua_error(L);
+}
+
+static int lua_cwrap_(lua_State* L)
+{
+    const char* name = luaL_checkstring(L, 1);
+    luaL_checktype(L, 2, LUA_TFUNCTION);
+    // the debug name must outlive the closure: intern it in the registry
+    lua_pushvalue(L, 1);
+    lua_pushboolean(L, 1);
+    lua_rawset(L, LUA_REGISTRYINDEX);
+    lua_pushvalue(L, 2);
+    if (lua_gettop(L) >= 4 && !lua_isnil(L, 3))
+    {
+        lua_pushvalue(L, 3);
+        lua_pushcclosure(L, cwrap_call_, name, 2);
+    }
+    else
+        lua_pushcclosure(L, cwrap_call_, name, 1);
+    return 1;
+}
+
+// devm: natives behind the executor API that harness.lua offers to scripts in executor mode
+// (getrawmetatable / setrawmetatable look behind __metatable, setreadonly / isreadonly reach the
+// table flag that table.freeze sets).  Handed out as the table __LPH_NATIVE, not as globals.
+static int lua_getrawmetatable_(lua_State* L)
+{
+    luaL_checkany(L, 1);
+    if (!lua_getmetatable(L, 1))
+        lua_pushnil(L);
+    return 1;
+}
+
+static int lua_setrawmetatable_(lua_State* L)
+{
+    luaL_checkany(L, 1);
+    int t = lua_type(L, 2);
+    luaL_argexpected(L, t == LUA_TNIL || t == LUA_TTABLE, 2, "nil or table");
+    lua_settop(L, 2);
+    if (lua_istable(L, 1) && lua_getreadonly(L, 1))
+    {
+        lua_setreadonly(L, 1, false);
+        lua_setmetatable(L, 1);
+        lua_setreadonly(L, 1, true);
+    }
+    else
+        lua_setmetatable(L, 1);
+    lua_settop(L, 1);
+    return 1;
+}
+
+static int lua_setreadonly_(lua_State* L)
+{
+    luaL_checktype(L, 1, LUA_TTABLE);
+    luaL_checktype(L, 2, LUA_TBOOLEAN);
+    lua_setreadonly(L, 1, lua_toboolean(L, 2));
+    return 0;
+}
+
+static int lua_isreadonly_(lua_State* L)
+{
+    luaL_checktype(L, 1, LUA_TTABLE);
+    lua_pushboolean(L, lua_getreadonly(L, 1));
+    return 1;
+}
+
+// devm: clonefunction for a Lua closure: a new closure of the same prototype with the same upvalues
+// (not equal to the original, same behaviour, same debug.info).  nil for a C function.
+static int lua_clonefunction_(lua_State* L)
+{
+    luaL_checktype(L, 1, LUA_TFUNCTION);
+    if (lua_iscfunction(L, 1))
+    {
+        lua_pushnil(L);
+        return 1;
+    }
+    lua_clonefunction(L, 1);
+    return 1;
+}
