 #include <locale.h>
 #include <signal.h>
 #include <stdlib.h>
+#include <string.h>
 
 LUAU_FASTFLAG(DebugLuauTimeTracing)
 
@@ -120,6 +121,94 @@ static int lua_loadstring(lua_State* L)
     return 2;          // return nil plus error message
 }
 
+static int lua_readfile_(lua_State* L)
+{
+    const char* path = luaL_checkstring(L, 1);
+    FILE* f = fopen(path, "rb");
+    if (!f)
+        luaL_error(L, "cannot open %s", path);
+    std::string data;
+    char buf[65536];
+    size_t n;
+    while ((n = fread(buf, 1, sizeof(buf), f)) > 0)
+        data.append(buf, n);
+    fclose(f);
+    lua_pushlstring(L, data.data(), data.size());
+    return 1;
+}
+
+static int lua_writefile_(lua_State* L)
+{
+    const char* path = luaL_checkstring(L, 1);
+    size_t l = 0;
+    const char* s = luaL_checklstring(L, 2, &l);
+    FILE* f = fopen(path, "wb");
+    if (!f)
+        luaL_error(L, "cannot open %s", path);
+    fwrite(s, 1, l, f);
+    fclose(f);
+    return 0;
+}
+
+static int lua_ewrite_(lua_State* L)
+{
+    size_t l = 0;
+    const char* s = luaL_checklstring(L, 1, &l);
+    fwrite(s, 1, l, stderr);
+    return 0;
+}
+
+static int lua_appendfile_(lua_State* L)
+{
+    const char* path = luaL_checkstring(L, 1);
+    size_t l = 0;
+    const char* s = luaL_checklstring(L, 2, &l);
+    FILE* f = fopen(path, "ab");
+    if (!f)
+        luaL_error(L, "cannot open %s", path);
+    fwrite(s, 1, l, f);
+    fclose(f);
+    return 0;
+}
+
+static double exitDeadline_ = 0;
+
+static void exitInterrupt_(lua_State* L, int gc)
+{
+    if (gc >= 0)
+        return;
+    if (exitDeadline_ > 0 && lua_clock() > exitDeadline_)
+        _exit(0);
+}
+
+// exitafter(seconds): hard-stop the process once the deadline passes (for scripts that spin forever)
+static int lua_exitafter_(lua_State* L)
+{
+    exitDeadline_ = lua_clock() + luaL_checknumber(L, 1);
+    lua_callbacks(L)->interrupt = exitInterrupt_;
+    return 0;
+}
+
+static int cwrapCall_(lua_State* L)
+{
+    int n = lua_gettop(L);
+    lua_pushvalue(L, lua_upvalueindex(1));
+    lua_insert(L, 1);
+    lua_call(L, n, LUA_MULTRET);
+    return lua_gettop(L);
+}
+
+// cwrap(fn, name): a C closure that forwards to fn, so environment stubs look like engine
+// builtins to debug.info (anti-tamper code checks that library functions are C functions)
+static int lua_cwrap_(lua_State* L)
+{
+    luaL_checktype(L, 1, LUA_TFUNCTION);
+    const char* name = strdup(luaL_optstring(L, 2, ""));
+    lua_pushvalue(L, 1);
+    lua_pushcclosurek(L, cwrapCall_, name, 1, NULL);
+    return 1;
+}
+
 static int lua_collectgarbage(lua_State* L)
 {
     const char* option = luaL_optstring(L, 1, "collect");
