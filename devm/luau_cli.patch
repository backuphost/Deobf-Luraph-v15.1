+// devm: the vector type has one metatable for all values and it can only be set through the C API
+static int lua_setvectormetatable_(lua_State* L)
+{
+    luaL_checktype(L, 1, LUA_TTABLE);
+    lua_pushvector(L, 0.0f, 0.0f, 0.0f);
+    lua_pushvalue(L, 1);
+    lua_setmetatable(L, -2);
+    return 0;
+}
