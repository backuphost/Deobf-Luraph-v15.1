+                    lua_pop(L, 1);
+                    status = LUA_ERRRUN;
+                }
+            }
+            else
+            {
+                lua_pop(L, 1);
+                if (mainStatus != 0)
+                    fprintf(stderr, "%s", message.c_str());
+            }
+            lua_pop(GL, 1);
+            lua_settop(L, 0);
+        }
     }
