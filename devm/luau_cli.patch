+
+        // devm: a script that returns a function asks for it to be run as the main function of a
+        // fresh top-level thread, i.e. at the call depth (Lua frames and C calls) of a script started
+        // by a scheduler. Afterwards the script's global __LPH_AFTER(ok, message) is called, if any.
+        if (status == 0 && lua_gettop(L) >= 1 && lua_isfunction(L, 1))
