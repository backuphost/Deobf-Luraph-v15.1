+            lua_State* T = lua_newthread(GL);
+            lua_pushvalue(L, 1);
+            lua_xmove(L, T, 1);
+            int mainStatus = lua_resume(T, NULL, 0);
+            std::string message;
+            if (mainStatus != 0)
